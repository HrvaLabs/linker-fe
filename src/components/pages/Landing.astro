---
import InstallButton from '../app/InstallButton.svelte';
import LangSwitch from './LangSwitch.astro';
import RegisterSW from './RegisterSW.astro';
import { tt, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEn = lang === 'en';
const landingHref = isEn ? '/en/landing' : '/landing';
const privacyHref = isEn ? '/en/privacy' : '/privacy';

const faqItems = [1, 2, 3, 4, 5].map((n) => ({
  q: tt(lang, `landing.faq.${n}.q`),
  a: tt(lang, `landing.faq.${n}.a`),
}));
---

<script is:inline>
  // Seeing "how it works" counts as a visit — next time the home goes straight to the app.
  try { localStorage.setItem('ladica-seen', '1'); } catch (e) {}
</script>

<header class="nav">
  <div class="container">
    <a class="brand" href="#top">
      <span class="mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 14.5l5-5"/><path d="M7.5 10.5l-2 2a3.5 3.5 0 0 0 5 5l2-2"/><path d="M16.5 13.5l2-2a3.5 3.5 0 0 0-5-5l-2 2"/></svg></span>
      Ladica
    </a>
    <div class="nav-right">
      <LangSwitch {lang} hrHref="/landing" enHref="/en/landing" />
      <a class="btn btn-primary" href="/app">{tt(lang, 'landing.navOpen')}</a>
    </div>
  </div>
</header>

<main id="top">
  <section class="hero">
    <div class="container">
      <div>
        <div><span class="brandpill">{tt(lang, 'brand.by')}</span></div>
        <span class="eyebrow">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          {tt(lang, 'landing.eyebrow')}
        </span>
        <h1 set:html={tt(lang, 'landing.h1')}></h1>
        <p class="lead">{tt(lang, 'landing.lead')}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/app">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
            {tt(lang, 'landing.ctaOpen')}
          </a>
          <a class="btn btn-ghost" href="#kako">{tt(lang, 'landing.ctaHow')}</a>
          <InstallButton client:visible variant="launcher" />
        </div>
        <p class="note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          {tt(lang, 'landing.note')}
        </p>
      </div>

      <div class="phone-wrap" aria-hidden="true">
        <div class="phone">
          <div class="screen">
            <div class="pscreen-top">
              <div class="ptitle"><span class="pm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 14.5l5-5"/><path d="M7.5 10.5l-2 2a3.5 3.5 0 0 0 5 5l2-2"/><path d="M16.5 13.5l2-2a3.5 3.5 0 0 0-5-5l-2 2"/></svg></span>{tt(lang, 'landing.phoneTitle')}</div>
              <div class="psub">{tt(lang, 'landing.phoneSub')}</div>
            </div>
            <div class="pchips">
              <span class="pchip on">{tt(lang, 'demo.all')}</span>
              <span class="pchip"><span class="d" style="background:var(--cat-cook)"></span>{tt(lang, 'demo.cook')}</span>
              <span class="pchip"><span class="d" style="background:var(--cat-shop)"></span>{tt(lang, 'demo.shop')}</span>
            </div>
            <div class="pcards">
              <div class="pcard">
                <span class="pcat" style="color:var(--cat-cook)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11h14l-1 9a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1z"/><path d="M12 11V7a3 3 0 0 1 6 0"/></svg>{tt(lang, 'demo.cook')}</span>
                <div class="pn">{tt(lang, 'demo.cardCook')}</div>
                <div class="pu">{tt(lang, 'demo.cardCookUrl')}</div>
                <div class="popen"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>{tt(lang, 'demo.open')}</div>
              </div>
              <div class="pcard">
                <span class="pcat" style="color:var(--cat-shop)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M3 4h2l2.2 11.2a1 1 0 0 0 1 .8h8.6a1 1 0 0 0 1-.78L21 8H6"/></svg>{tt(lang, 'demo.shop')}</span>
                <div class="pn">{tt(lang, 'demo.cardShop')}</div>
                <div class="pu">{tt(lang, 'demo.cardShopUrl')}</div>
                <div class="popen"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>{tt(lang, 'demo.open')}</div>
              </div>
            </div>
            <div class="padd">＋ {tt(lang, 'demo.add')}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <div class="heading">
        <h2>{tt(lang, 'landing.feat.title')}</h2>
        <p>{tt(lang, 'landing.feat.sub')}</p>
      </div>
      <div class="grid3">
        <div class="card">
          <div class="ico" style="background:var(--accent)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></div>
          <h3>{tt(lang, 'landing.feat.1.h')}</h3>
          <p>{tt(lang, 'landing.feat.1.p')}</p>
        </div>
        <div class="card">
          <div class="ico" style="background:var(--cat-cook)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11h14l-1 9a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1z"/><path d="M12 11V7a3 3 0 0 1 6 0"/></svg></div>
          <h3>{tt(lang, 'landing.feat.2.h')}</h3>
          <p>{tt(lang, 'landing.feat.2.p')}</p>
        </div>
        <div class="card">
          <div class="ico" style="background:var(--cat-shop)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="3" width="8" height="4" rx="1.2"/><path d="M16 5h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2"/></svg></div>
          <h3>{tt(lang, 'landing.feat.3.h')}</h3>
          <p>{tt(lang, 'landing.feat.3.p')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block" id="kako">
    <div class="container">
      <div class="heading">
        <h2>{tt(lang, 'landing.how.title')}</h2>
        <p>{tt(lang, 'landing.how.sub')}</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="n"></div>
          <h3>{tt(lang, 'landing.step.1.h')}</h3>
          <p>{tt(lang, 'landing.step.1.p')}</p>
        </div>
        <div class="step">
          <div class="n"></div>
          <h3>{tt(lang, 'landing.step.2.h')}</h3>
          <p>{tt(lang, 'landing.step.2.p')}</p>
        </div>
        <div class="step">
          <div class="n"></div>
          <h3>{tt(lang, 'landing.step.3.h')}</h3>
          <p>{tt(lang, 'landing.step.3.p')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block" id="faq">
    <div class="container">
      <div class="heading">
        <h2>{tt(lang, 'landing.faq.title')}</h2>
      </div>
      <div class="faq">
        {faqItems.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <div class="cta">
        <h2>{tt(lang, 'landing.cta.h')}</h2>
        <p>{tt(lang, 'landing.cta.p')}</p>
        <a class="btn btn-primary" href="/app">{tt(lang, 'landing.cta.btn')}</a>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="container">
    <span>{tt(lang, 'landing.footTagline')}<br>{tt(lang, 'foot.contact')} <a href="mailto:ladica@hrvalabs.net">ladica@hrvalabs.net</a> · <a href={privacyHref}>{tt(lang, 'foot.privacy')}</a> · <a href="https://karlo.cc/" target="_blank" rel="noopener noreferrer">Karlo Hrvačić</a></span>
    <span class="legal" set:html={tt(lang, 'foot.legal')}></span>
  </div>
</footer>

<RegisterSW />

<style is:global>
  body { background: var(--app-bg); }
</style>

<style>
  a { color: inherit; text-decoration: none; }
  p { text-wrap: pretty; }
  h1, h2, h3 { text-wrap: balance; margin: 0; letter-spacing: -0.02em; }
  .container { max-width: var(--container); margin-inline: auto; padding-inline: 22px; }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 54px; padding: 0 24px; border-radius: 14px; font-size: 17px; font-weight: var(--w-bold); border: 1.5px solid transparent; cursor: pointer; transition: transform .05s, background .15s, border-color .15s; }
  .btn svg { width: 19px; height: 19px; }
  .btn:active { transform: translateY(1px); }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: var(--accent-dk); }
  .btn-ghost { background: var(--surface); color: var(--fg); border-color: var(--border); }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent-dk); }

  .nav { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--app-bg) 86%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
  .nav .container { display: flex; align-items: center; justify-content: space-between; min-height: 66px; gap: 12px; }
  .nav-right { display: flex; align-items: center; gap: 10px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: var(--w-heavy); font-size: 19px; letter-spacing: -0.02em; }
  .brand .mark { width: 32px; height: 32px; border-radius: 10px; background: var(--accent); display: grid; place-items: center; color: #fff; }
  .brand .mark svg { width: 19px; height: 19px; }
  .nav .btn { min-height: 44px; font-size: 15px; padding: 0 16px; }

  .hero { padding: clamp(40px, 7vw, 84px) 0 clamp(48px, 7vw, 90px); }
  .hero .container { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .brandpill { display: inline-block; font-size: 12px; font-weight: var(--w-heavy); letter-spacing: .06em; text-transform: uppercase; color: var(--accent-dk); background: var(--soft); padding: 6px 12px; border-radius: 999px; margin-bottom: 14px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: var(--w-bold); color: var(--accent-dk); background: var(--soft); padding: 7px 14px; border-radius: 999px; margin-bottom: 20px; }
  .hero h1 { font-size: clamp(34px, 5.4vw, 56px); line-height: 1.05; font-weight: var(--w-heavy); }
  .hero p.lead { font-size: clamp(17px, 2.2vw, 20px); color: var(--muted); margin: 18px 0 28px; max-width: 30ch; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .note { margin-top: 16px; font-size: 14px; color: var(--muted); display: flex; align-items: center; gap: 8px; }
  .note svg { width: 16px; height: 16px; color: var(--accent); }

  @media (max-width: 860px) {
    .hero .container { grid-template-columns: 1fr; text-align: center; }
    .hero p.lead { margin-inline: auto; }
    .hero-cta, .note { justify-content: center; }
    .phone-wrap { order: -1; }
  }

  .phone-wrap { display: flex; justify-content: center; }
  .phone { width: 290px; max-width: 84vw; background: #11201a; border-radius: 40px; padding: 11px; box-shadow: 0 30px 60px rgba(15,40,25,.22), 0 6px 16px rgba(15,40,25,.12); }
  .phone .screen { background: var(--surface); border-radius: 30px; overflow: hidden; }
  .pscreen-top { padding: 18px 16px 12px; }
  .pscreen-top .ptitle { display: flex; align-items: center; gap: 8px; font-size: 19px; font-weight: var(--w-heavy); letter-spacing: -0.02em; }
  .pscreen-top .ptitle .pm { width: 24px; height: 24px; border-radius: 7px; background: var(--accent); display: grid; place-items: center; color: #fff; }
  .pscreen-top .ptitle .pm svg { width: 14px; height: 14px; }
  .pscreen-top .psub { color: var(--muted); font-size: 12.5px; margin: 3px 0 0 32px; }
  .pchips { display: flex; gap: 6px; padding: 4px 16px 12px; overflow: hidden; }
  .pchip { font-size: 11.5px; font-weight: var(--w-bold); padding: 6px 10px; border-radius: 999px; border: 1.4px solid var(--border); display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
  .pchip .d { width: 7px; height: 7px; border-radius: 999px; }
  .pchip.on { border-color: var(--accent); background: var(--soft); color: var(--accent-dk); }
  .pcards { padding: 0 16px 16px; display: flex; flex-direction: column; gap: 10px; }
  .pcard { border: 1px solid var(--border); border-radius: 16px; padding: 12px; box-shadow: 0 4px 12px rgba(20,40,30,.05); }
  .pcat { font-size: 11px; font-weight: var(--w-heavy); display: inline-flex; align-items: center; gap: 5px; }
  .pcat svg { width: 13px; height: 13px; }
  .pcard .pn { font-weight: var(--w-bold); font-size: 14.5px; margin-top: 5px; }
  .pcard .pu { color: var(--muted); font-size: 12px; margin-top: 1px; }
  .popen { margin-top: 9px; background: var(--accent); color: #fff; border-radius: 10px; text-align: center; font-weight: var(--w-bold); font-size: 13.5px; padding: 9px; display: flex; align-items: center; justify-content: center; gap: 6px; }
  .popen svg { width: 14px; height: 14px; }
  .padd { margin: 4px 16px 16px; background: var(--accent); color: #fff; border-radius: 13px; text-align: center; font-weight: var(--w-heavy); font-size: 14px; padding: 13px; }

  section.block { padding: clamp(44px, 7vw, 80px) 0; border-top: 1px solid var(--border); }
  .heading { max-width: 30ch; margin-bottom: 36px; }
  .heading h2 { font-size: clamp(26px, 3.6vw, 38px); font-weight: var(--w-heavy); }
  .heading p { color: var(--muted); margin: 12px 0 0; font-size: 18px; }

  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  @media (max-width: 820px) { .grid3 { grid-template-columns: 1fr; } }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 26px; }
  .card .ico { width: 46px; height: 46px; border-radius: 13px; display: grid; place-items: center; color: #fff; margin-bottom: 16px; }
  .card .ico svg { width: 23px; height: 23px; }
  .card h3 { font-size: 20px; font-weight: var(--w-bold); }
  .card p { color: var(--muted); margin: 8px 0 0; font-size: 16px; }

  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; counter-reset: s; }
  @media (max-width: 820px) { .steps { grid-template-columns: 1fr; } }
  .step { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 26px; position: relative; }
  .step .n { counter-increment: s; width: 38px; height: 38px; border-radius: 12px; background: var(--soft); color: var(--accent-dk); display: grid; place-items: center; font-weight: var(--w-heavy); font-size: 18px; margin-bottom: 14px; }
  .step .n::before { content: counter(s); }
  .step h3 { font-size: 18px; font-weight: var(--w-bold); }
  .step p { color: var(--muted); margin: 7px 0 0; font-size: 15.5px; }

  .cta { background: linear-gradient(160deg, #166b34, #15803d); color: #fff; border-radius: var(--radius-lg); padding: clamp(34px, 5vw, 56px); text-align: center; }
  .cta h2 { font-size: clamp(26px, 3.6vw, 40px); font-weight: var(--w-heavy); }
  .cta p { color: #d6efe0; margin: 14px auto 26px; max-width: 40ch; font-size: 18px; }
  .cta .btn-primary { background: #fff; color: var(--accent-dk); }
  .cta .btn-primary:hover { background: #eafaf0; }

  .faq { display: flex; flex-direction: column; gap: 10px; max-width: 760px; }
  .faq-item { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
  .faq-item summary { cursor: pointer; list-style: none; padding: 16px 18px; font-size: 17px; font-weight: var(--w-bold); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; color: var(--accent); font-weight: var(--w-heavy); font-size: 22px; line-height: 1; }
  .faq-item[open] summary::after { content: "−"; }
  .faq-item p { margin: 0; padding: 0 18px 16px; color: var(--muted); font-size: 16px; line-height: 1.6; }

  footer { padding: 40px 0; border-top: 1px solid var(--border); color: var(--muted); font-size: 14px; }
  footer .container { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
  footer a { color: var(--accent-dk); }
  footer a:hover { text-decoration: underline; }
  footer .legal { font-size: 13px; }

  /* Reduced motion: drop the button press lift (and any hover transitions). */
  @media (prefers-reduced-motion: reduce) {
    .btn, .card, .step { transition: none; }
    .btn:active { transform: none; }
  }
</style>
